C {code.sym} -570 -130 0 0 {name=Simulation only_toplevel=false value="
.lib /usr/local/share/pdk/sky130A/libs.tech/ngspice/sky130.lib.spice ff

.op
.save all

.control
  set noaskquit

  let n = 7
  let tvec = vector(n)

  let ivec = vector(n)
  let ivec2p = vector(n)
  let ivec2n = vector(n)
  let ivec3p = vector(n)
  let ivec3n = vector(n)
  let ivec4p = vector(n)
  let ivec4n = vector(n)

  let refvec = vector(n)
  let idx = 0

  foreach t -40 -20 0 27 60 85 125
    set temp = $t
    run

    let tvec[idx] = $t

    let ivec[idx] = i(v2)
    let ivec2p[idx] = i(vip)
    let ivec2n[idx] = i(vin)
    let ivec3p[idx] = i(vip1)
    let ivec3n[idx] = i(vin1)
    let ivec4p[idx] = i(vip2)
    let ivec4n[idx] = i(vin2)

    let refvec[idx] = i(v3)

    print $t i(v2)
    print $t i(v3)

    let idx = idx + 1
  end

  plot ivec4p ivec4n refvec vs tvec

.endc

.end
"}
