C {code.sym} -820 -370 0 0 {name=Simulation only_toplevel=false value="

.include /home/zhixuan/projects/fyp_vco/magic/ip/comp_p/comp_p.spice
.include /home/zhixuan/projects/fyp_vco/magic/ip/comp_n/comp_n.spice
.include /home/zhixuan/projects/fyp_vco/magic/ip/sr_latch/sr_latch.spice
.include /home/zhixuan/projects/fyp_vco/magic/ip/inv_1/inv_1.spice
.include /home/zhixuan/projects/fyp_vco/magic/ip/pseudo_res/pseudo_res.spice
.include /home/zhixuan/projects/fyp_vco/magic/ip/ptat/ptat.spice
.include /home/zhixuan/projects/fyp_vco/magic/ip/opamp/opamp.spice


.lib /usr/local/share/pdk/sky130A/libs.tech/ngspice/sky130.lib.spice tt

.tran 0.1n 2u
.save all

.control
    run
    
    * Find rising edges of feedback signal (threshold at 0.9V for 1.8V signal)
    meas tran t1 when feedback=0.9 rise=2
    meas tran t2 when feedback=0.9 rise=3
    
    * Calculate period and frequency from 2nd period onwards
    let period = t2 - t1
    let freq = 1 / period
    
    print period
    print freq

    plot low high v_cap prev1out out1
    plot abs(i(vdd))*1.8 + abs(i(vddcharge))*1.8
.endc

.end
"}
